# Supabase connection for the TaskFlow landing page.
#
# Both values below are safe to commit and safe to ship in the browser bundle.
# The publishable key only identifies the project to Supabase's API gateway; it
# grants no data access on its own. The `signups` table has row-level security
# enabled with zero policies, so this key cannot read or write it. All writes go
# through the `signup` Edge Function, which holds the service role key
# server-side and never exposes it.
#
# Put real secrets in .env.local instead — that file is gitignored.

VITE_SUPABASE_URL=https://ytmuhvnsazgwgjrrfzgj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ga7pX05-ZkVwNZ6X7-2_-g_NR9y3qzl
